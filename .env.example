# For a static frontend with a separately hosted server:
# VITE_ROOM_SERVER=wss://your-server.example/room
# For a combined Node deployment (build-time setting):
# VITE_SAME_ORIGIN_SERVER=true
# Server settings (runtime):
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=8788
# ALLOWED_ORIGINS=https://your-world.example
# Production refuses missing/non-HTTPS/wildcard origins. No path or trailing slash.
# Keep exactly one instance until room state has shared storage/routing.
